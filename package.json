{
  "name": "lord-of-kings",
  "version": "1.0.0",
  "private": true,
  "description": "King's Fall — Dravida 3D Chess (Web, Desktop & Mobile)",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:web": "npm --prefix web run dev",
    "dev:desktop": "npm --prefix desktop run dev",
