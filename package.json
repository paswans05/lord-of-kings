    "dist:desktop": "npm --prefix desktop run dist",
    "test": "npm --prefix web test"
  },
  "keywords": [
    "chess",
    "3d-chess",
    "threejs",
    "electron",
    "flutter",
    "sqlite",
    "wasm"
