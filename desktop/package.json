{
  "name": "kings-fall-desktop",
  "version": "1.0.0",
  "description": "King's Fall: Dravida 3D Chess Standalone Desktop Application",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:8080 && tsc -p tsconfig.electron.json && electron . --dev\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron . --dev",
    "start": "tsc -p tsconfig.electron.json && electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "dist:dir": "vite build && tsc -p tsconfig.electron.json && electron-builder --dir",
    "preview": "vite preview"
  },
  "keywords": [
    "chess",
    "3d-chess",
    "electron",
    "desktop-app",
    "dravida-chess",
    "threejs",
    "sqlite"
  ],
  "author": "King's Fall Team",
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
